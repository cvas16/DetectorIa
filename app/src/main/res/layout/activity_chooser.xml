<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".ui.activities.ChooserActivity"
    tools:theme="@style/AppTheme">

    <!-- Navbar Oscuro -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chooser_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#121212"
        app:title="@string/app_name"
        app:titleTextColor="@color/white"
        app:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chooser_toolbar">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/ic_launcher_lion" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ListView ahora ocupa el espacio disponible correctamente -->
        <ListView
            android:id="@+id/test_activity_list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#33FFFFFF"
            android:dividerHeight="0.5dp"
            tools:listitem="@android:layout/simple_list_item_1" />

        <!-- Botón con ancho adecuado y centrado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="16dp"
            android:paddingHorizontal="32dp"
            android:text="@string/logout"
            android:textColor="#FF5252"
            app:strokeColor="#FF5252"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconTint="#FF5252" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>